{
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "postinstall": "bun run ./scripts/install-hooks.ts && bun run validate:skills",
    "setup:hooks": "bun run ./scripts/install-hooks.ts",
    "validate:skills": "bun run ./scripts/validate-skills.ts",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:check": "bun run --cwd apps/docs check",
    "docs": "bun run docs:dev",
    "clean:package-src-declarations": "bun run scripts/check-generated-files.ts --clean-package-src-declarations",
    "check:package-src-declarations": "bun run scripts/check-generated-files.ts --check-package-src-declarations",
    "build:packages": "bun run clean:package-src-declarations && bun run --filter '@dryui/lint' build && bun run --filter '@dryui/primitives' build && bun run --filter '@dryui/ui' build && bun run --filter '@dryui/feedback' build && bun run --filter '@dryui/feedback-server' build && bun run clean:package-src-declarations",
    "build:docs": "bun run build:packages && bun run docs:build",
    "build": "bun run build:docs",
    "sync:exports": "bun run scripts/sync-package-exports.ts",
    "test:unit": "bun run ./scripts/test-unit.ts",
    "test:browser": "vitest --browser --run tests/browser",
    "test:docs-visual": "bun --bun playwright test -c playwright.docs.config.ts",
    "test:docs-visual:update": "bun --bun playwright test -c playwright.docs.config.ts --update-snapshots",
    "test:feedback-bounds": "bun --bun playwright test -c playwright.feedback.config.ts",
    "test": "bun run test:unit && bun run test:browser",
    "test:coverage:unit": "bun run ./scripts/test-unit.ts --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage/unit",
    "test:coverage:browser": "vitest --browser --run --coverage --coverage.provider=v8 --coverage.reportsDirectory=coverage/browser --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary tests/browser",
    "coverage:summary": "bun run ./scripts/coverage-summary.ts",
    "coverage:check": "bun run ./scripts/check-coverage-baseline.ts",
    "check:interactive-coverage": "bun run ./scripts/check-interactive-coverage.ts",
    "test:coverage": "bun run test:coverage:unit && bun run test:coverage:browser && bun run coverage:summary",
    "check:exports": "bun run scripts/sync-package-exports.ts --check",
    "check:packages": "bun run --filter '@dryui/primitives' check && bun run --filter '@dryui/ui' check && bun run --filter '@dryui/feedback' check",
    "check:docs": "bun run docs:check",
    "check:feedback-server": "bun run --filter '@dryui/feedback-server' check",
    "check:lint": "bun run --filter '@dryui/lint' test",
    "check:lint:violations": "bun run scripts/check-lint-violations.ts",
    "check:publish-hygiene": "bun run scripts/check-publish-hygiene.ts --swap",
    "bench:smoke": "bun run scripts/benchmark/run.ts --smoke",
    "bench:summary": "bun run scripts/benchmark/summary.ts",
    "bench:compare": "bun run scripts/benchmark/compare.ts",
    "bench:check": "bun run scripts/benchmark/check-baseline.ts",
    "check": "bun run check:package-src-declarations && bun run check:exports && bun run check:packages && bun run check:docs && bun run check:feedback-server && bun run check:lint && bun run check:lint:violations",
    "validate": "bun run ./scripts/validate.ts",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish:packages": "bun scripts/publish-packages.ts",
    "release:ci": "bun run scripts/release-ci.ts",
    "release:gate": "bun run validate --no-test --skip-publish-hygiene",
    "release": "bun run release:gate && bun run version && bun run publish:packages",
    "dev:link": "bun run ./scripts/dev-link.ts",
    "dev:unlink": "bun run ./scripts/dev-link.ts --unlink",
    "eval:loop": "bun run scripts/eval/run-loop.ts",
    "dev:ui:watch": "cd packages/feedback-server && vite build --watch --config ui/vite.config.ts",
    "e2e:assets": "bun run ./scripts/e2e/generate-placeholder-assets.ts",
    "e2e:pack": "bun run ./scripts/e2e/pack-dev-versions.ts",
    "e2e:full": "bun run ./scripts/e2e/run.ts --agent-matrix",
    "e2e:one": "bun run ./scripts/e2e/run.ts --agent-matrix --only",
    "bump-deps": "npm-check-updates -u --deep --dep prod,dev,peer,optional --target latest && bun install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "npm-check-updates": "22.1.0",
    "playwright": "1.59.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "publint": "0.3.18",
    "svelte": "^5.55.5",
    "vitest": "^4.1.5"
  }
}
