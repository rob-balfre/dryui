#!/bin/sh

STAGED=$(git diff --cached --name-only)

# Validate every staged SKILL.md against the npx skills spec
# (frontmatter present, name=dirname, description length budget).
# Phase 6 of the npx skills migration removed the legacy sync:skills
# regeneration; validate:skills is the only check that runs here.
if echo "$STAGED" | grep -qE '^skills/.*/SKILL\.md$|^skills/[^/]+/'; then
  echo "[pre-commit] SKILL.md changed: validating frontmatter..."
  bun run validate:skills || exit 1
fi

# Check formatting on staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|svelte|json|css|md)$' || true)
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs bunx prettier --check 2>/dev/null
  if [ $? -ne 0 ]; then
    echo ""
    echo "[pre-commit] Formatting check failed. Run 'bun run format' and re-stage."
    exit 1
  fi
fi
